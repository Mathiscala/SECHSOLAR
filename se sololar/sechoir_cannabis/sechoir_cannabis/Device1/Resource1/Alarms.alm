<?xml version="1.0" encoding="utf-8"?>
<Alarms UnitConversionZone="STD_UOM_ZONE_UI">
  <Alarm Name="Al_retain" Type="ManualReset" Trigger="Al_retain.Trigger" Active="Al_retain.Active" StorVar1="MemWritingsNo" Description="Error in the number of retain memory writings" />
  <Alarm Name="Al_Err_retain_write" Type="ManualReset" Trigger="Al_Err_retain_write.Trigger" Active="Al_Err_retain_write.Active" Description="Error in retain memory writings" />
  <Alarm Name="Al_Tint_haute" Type="AutoReset" Trigger="Al_Tint_haute.Trigger" Active="Al_Tint_haute.Active" Description="Température intérieure trop élevée" />
  <Alarm Name="Al_Tint_basse" Type="AutoReset" Trigger="Al_Tint_basse.Trigger" Active="Al_Tint_basse.Active" Description="Température intérieure trop basse" />
  <Alarm Name="Al_HRint_haute" Type="AutoReset" Trigger="Al_HRint_haute.Trigger" Active="Al_HRint_haute.Active" Description="HR intérieur trop élevée" />
  <Alarm Name="Al_HRint_basse" Type="AutoReset" Trigger="Al_HRint_basse.Trigger" Active="Al_HRint_basse.Active" Description="HR intérieur trop basse" />
  <Alarm Name="Al_duree" Type="AutoReset" Trigger="Al_duree.Trigger" Active="Al_duree.Active" Description="Durée de séchage = 0" />
</Alarms>